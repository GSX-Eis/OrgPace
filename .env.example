# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Employee Profile Platform"

# Optional Sentry error reporting and trace sampling (0.0–1.0)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Login rate limits (shared across backend workers)
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=300
LOGIN_LOCK_MINUTES=15
OAUTH_REGISTER_MAX_PER_IP_HOUR=10

SECRET_KEY=changethis
# Optional comma-separated Fernet keys for stored DB secrets (defaults to SECRET_KEY HKDF when unset).
# First key encrypts new secrets; all listed keys plus legacy SECRET_KEY are tried on decrypt for zero-downtime rotation.
# Rotation order:
#   1. Deploy/restart ALL writer processes (backend, worker, im) with ENCRYPTION_KEYS="K_NEW,K_OLD" (keep SECRET_KEY until step 4).
#   2. Run dry-run: python -m app.core.reencrypt_secrets --dry-run (verifies decryption and reports pending_values).
#   3. Run apply:   python -m app.core.reencrypt_secrets (confirm failed=0 unresolved=0, then re-run --dry-run to verify pending_values=0).
#   4. Retire K_OLD (or rotate SECRET_KEY) only after step 3 confirms 0 pending/failed/unresolved and no old-key writers remain.
#      Note: previously issued bot project draft links expire once the key that signed them is retired.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEYS=
PI_SERVICE_TOKEN=changethis
# Local Python clients can override PI_URL; Compose uses http://pi:8081.
# PI_URL=http://127.0.0.1:8081
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Synthetic data only; turn off for non-demo deployments
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=demo-password-2026

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Default API listener: 127.0.0.1:8000
# API_BIND=127.0.0.1
# API_PORT=8000

# Mock Jira (development and --demo only; synthetic data)
# MOCK_JIRA_EMAIL=jira-admin@example.com
# MOCK_JIRA_API_TOKEN=mock-cloud-token
# MOCK_JIRA_PAT=mock-dc-pat
# MOCK_JIRA_USERNAME=jira-admin
# MOCK_JIRA_PASSWORD=mock-password
